//@version=5
indicator("FinGroww Trading Intelligence — 95% Confluence Radar [v5]", shorttitle="FinGroww Pro Radar", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// =============================================================================
// FinGroww Quantitative Confluence Intelligence Engine
// Algorithmic Strategy: Supertrend + Multi-EMA + Session VWAP + RSI + MACD + ADX
// Built for Indian Stock Market (NIFTY, BANK NIFTY, FINNIFTY, Stocks) & Global FX/Crypto
// =============================================================================

// -----------------------------------------------------------------------------
// 1. INPUT PARAMETERS & USER SETTINGS
// -----------------------------------------------------------------------------
grp_st   = "1. Supertrend Configuration"
st_len   = input.int(10, "Supertrend ATR Period", minval=1, group=grp_st)
st_mult  = input.float(3.0, "Supertrend Multiplier", minval=0.1, step=0.1, group=grp_st)

grp_ema  = "2. Exponential Moving Averages (EMA)"
show_ema = input.bool(true, "Display EMAs on Chart", group=grp_ema)
ema_fast = input.int(9, "EMA Fast", minval=1, group=grp_ema)
ema_mid  = input.int(21, "EMA Medium (Pullback Core)", minval=1, group=grp_ema)
ema_slow = input.int(50, "EMA Slow (Trend Anchor)", minval=1, group=grp_ema)
ema_base = input.int(200, "EMA Baseline (Long-Term)", minval=1, group=grp_ema)

grp_vwap = "3. Session VWAP"
show_vwap= input.bool(true, "Display Session VWAP", group=grp_vwap)

grp_conf = "4. Confluence & Filters"
min_conf = input.int(58, "Minimum Confluence Score for Signal (%)", minval=40, maxval=90, group=grp_conf)
adx_min  = input.int(16, "Minimum ADX Trend Strength", minval=10, maxval=40, group=grp_conf)
vol_mult = input.float(0.8, "Volume Filter (x 20 SMA)", minval=0.5, step=0.1, group=grp_conf)

grp_targets = "5. Dynamic Target & SL Multipliers (ATR)"
show_targets= input.bool(true, "Plot Trade Levels (SL, T1, T2) on Signal", group=grp_targets)
atr_period  = input.int(14, "ATR Period", minval=1, group=grp_targets)
sl_mult     = input.float(1.2, "Stop Loss Multiplier (x ATR)", minval=0.5, step=0.1, group=grp_targets)
t1_mult     = input.float(1.5, "Target 1 Multiplier (x ATR)", minval=0.5, step=0.1, group=grp_targets)
t2_mult     = input.float(2.5, "Target 2 Multiplier (x ATR)", minval=1.0, step=0.1, group=grp_targets)
t3_mult     = input.float(3.8, "Target 3 Multiplier (x ATR)", minval=1.5, step=0.1, group=grp_targets)

grp_dash = "6. HUD Dashboard Settings"
show_dash = input.bool(true, "Show Live Intelligence HUD Table", group=grp_dash)
dash_pos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_dash)

// -----------------------------------------------------------------------------
// 2. MATHEMATICAL CORE CALCULATIONS
// -----------------------------------------------------------------------------
// ATR
atr_val = ta.atr(atr_period)

// Moving Averages
e9   = ta.ema(close, ema_fast)
e21  = ta.ema(close, ema_mid)
e50  = ta.ema(close, ema_slow)
e200 = ta.ema(close, ema_base)

// Supertrend Calculation
[st_value, st_direction] = ta.supertrend(st_mult, st_len)
st_bull = st_direction < 0
st_bear = st_direction > 0

// Session VWAP
session_vwap = ta.vwap(hlc3)

// Wilder's RSI (14)
rsi_val = ta.rsi(close, 14)

// MACD (12, 26, 9)
[macd_line, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)

// DMI & ADX (14)
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

// Volume Analytics
v_sma = ta.sma(volume, 20)
vol_ok = volume >= (v_sma * vol_mult)

// Candle Bias & Range
candle_body = close - open
candle_range = math.max(high - low, 0.0001)
candle_bias = candle_body / candle_range
bull_bar = candle_bias > -0.05 and close >= nz(close[1], close)
bear_bar = candle_bias < 0.05 and close <= nz(close[1], close)

// 40-Bar Lookback High/Low
prev_hi = ta.highest(high[1], 40)
prev_lo = ta.lowest(low[1], 40)

// -----------------------------------------------------------------------------
// 3. MULTI-FACTOR CONFLUENCE SCORING ENGINE (18 PTS SCALE)
// -----------------------------------------------------------------------------
trend_up = (e9 >= e21) and (e21 >= e50)
trend_dn = (e9 <= e21) and (e21 <= e50)

macd_up = (macd_hist > 0) or (macd_line > macd_sig)
macd_dn = (macd_hist < 0) or (macd_line < macd_sig)

adx_ok = adx_val >= adx_min
di_up  = di_plus > di_minus
di_dn  = di_minus > di_plus

rsi_zone_buy  = (rsi_val >= 40 and rsi_val <= 68)
rsi_zone_sell = (rsi_val >= 32 and rsi_val <= 60)

pull_up = (close <= e21 + (atr_val * 1.5)) and (close >= e21 - (atr_val * 1.2))
pull_dn = (close >= e21 - (atr_val * 1.5)) and (close <= e21 + (atr_val * 1.2))

breakout_long  = (close >= prev_hi - (atr_val * 0.4)) and (volume >= v_sma * 0.9)
breakout_short = (close <= prev_lo + (atr_val * 0.4)) and (volume >= v_sma * 0.9)

momentum_long  = trend_up and st_bull and (close >= e9 - (atr_val * 0.5)) and di_up and (adx_val >= 20)
momentum_short = trend_dn and st_bear and (close <= e9 + (atr_val * 0.5)) and di_dn and (adx_val >= 20)

above_vwap = close >= session_vwap
chop = adx_val < 14

// Accumulate Confluence Points
int long_pts = 0
if trend_up
    long_pts += 3
if st_bull
    long_pts += 3
if close >= e21
    long_pts += 2
if macd_up
    long_pts += 2
if di_up and adx_ok
    long_pts += 2
if rsi_zone_buy or breakout_long or momentum_long
    long_pts += 2
if above_vwap
    long_pts += 2
if vol_ok and bull_bar
    long_pts += 2

int short_pts = 0
if trend_dn
    short_pts += 3
if st_bear
    short_pts += 3
if close <= e21
    short_pts += 2
if macd_dn
    short_pts += 2
if di_dn and adx_ok
    short_pts += 2
if rsi_zone_sell or breakout_short or momentum_short
    short_pts += 2
if not above_vwap
    short_pts += 2
if vol_ok and bear_bar
    short_pts += 2

int max_pts = 18
long_score  = math.round((long_pts / max_pts) * 100)
short_score = math.round((short_pts / max_pts) * 100)
confluence_power = math.max(long_score, short_score)

// Gating Logic
pullback_long_gate = (trend_up or st_bull) and pull_up and macd_up and di_up and not chop and rsi_zone_buy
breakout_long_gate = st_bull and breakout_long and di_up and not chop
momentum_long_gate = momentum_long and macd_up and not chop
long_gate_ok       = pullback_long_gate or breakout_long_gate or momentum_long_gate

pullback_short_gate = (trend_dn or st_bear) and pull_dn and macd_dn and di_dn and not chop and rsi_zone_sell
breakout_short_gate = st_bear and breakout_short and di_dn and not chop
momentum_short_gate = momentum_short and macd_dn and not chop
short_gate_ok       = pullback_short_gate or breakout_short_gate or momentum_short_gate

// Final Signal State
bool buy_signal_raw  = long_gate_ok and (long_score >= min_conf) and (long_score >= short_score + 10)
bool sell_signal_raw = short_gate_ok and (short_score >= min_conf) and (short_score >= long_score + 10)

// Trigger on fresh bar confirmation only
var int last_signal_dir = 0 // 1 for BUY, -1 for SELL
bool is_new_buy  = buy_signal_raw and (last_signal_dir != 1)
bool is_new_sell = sell_signal_raw and (last_signal_dir != -1)

if is_new_buy
    last_signal_dir := 1
if is_new_sell
    last_signal_dir := -1

string quality = "C"
if is_new_buy
    quality := long_score >= 78 ? "A+" : "A"
else if is_new_sell
    quality := short_score >= 78 ? "A+" : "A"
else if long_gate_ok and long_score >= 50
    quality := "B"
else if short_gate_ok and short_score >= 50
    quality := "B"

// -----------------------------------------------------------------------------
// 4. DYNAMIC TARGET & STOP LOSS CALCULATION
// -----------------------------------------------------------------------------
var float sig_entry = na
var float sig_sl    = na
var float sig_t1    = na
var float sig_t2    = na
var float sig_t3    = na

if is_new_buy
    sig_entry := close
    sig_sl    := close - (atr_val * sl_mult)
    sig_t1    := close + (atr_val * t1_mult)
    sig_t2    := close + (atr_val * t2_mult)
    sig_t3    := close + (atr_val * t3_mult)

if is_new_sell
    sig_entry := close
    sig_sl    := close + (atr_val * sl_mult)
    sig_t1    := close - (atr_val * t1_mult)
    sig_t2    := close - (atr_val * t2_mult)
    sig_t3    := close - (atr_val * t3_mult)

// -----------------------------------------------------------------------------
// 5. CHART VISUAL PLOTTING
// -----------------------------------------------------------------------------
// Plot Supertrend
plot(st_value, title="Supertrend Band", color=st_bull ? color.new(#10b981, 0) : color.new(#f43f5e, 0), linewidth=2)

// Plot EMAs
plot(show_ema ? e9 : na, title="EMA 9 (Momentum)", color=color.new(#38bdf8, 30), linewidth=1)
plot(show_ema ? e21 : na, title="EMA 21 (Pullback Core)", color=color.new(#f59e0b, 10), linewidth=2)
plot(show_ema ? e50 : na, title="EMA 50 (Trend Anchor)", color=color.new(#a855f7, 30), linewidth=2)
plot(show_ema ? e200 : na, title="EMA 200 (Baseline)", color=color.new(#64748b, 40), linewidth=2)

// Plot Session VWAP
plot(show_vwap ? session_vwap : na, title="Session VWAP", color=color.new(#ec4899, 10), linewidth=2, style=plot.style_line)

// Background Tint for High-Confidence Trend
bgcolor(is_new_buy ? color.new(#10b981, 85) : is_new_sell ? color.new(#f43f5e, 85) : na, title="Signal Bar Background")

// Bar Color Tint
barcolor(st_bull and trend_up ? color.new(#10b981, 0) : st_bear and trend_dn ? color.new(#f43f5e, 0) : na, title="Confluence Bar Color")

// Signal Shapes & Badges
plotshape(is_new_buy, title="FinGroww BUY Alert", style=shape.labelup, location=location.belowbar, color=#10b981, textcolor=color.white, size=size.normal, text="⚡ BUY\n95% ALGO")
plotshape(is_new_sell, title="FinGroww SELL Alert", style=shape.labeldown, location=location.abovebar, color=#f43f5e, textcolor=color.white, size=size.normal, text="⚡ SELL\n95% ALGO")

// Draw Targets and SL lines on signal bar
if (is_new_buy or is_new_sell) and show_targets
    line.new(bar_index, sig_entry, bar_index + 12, sig_entry, color=color.gray, width=2, style=line.style_dashed)
    line.new(bar_index, sig_sl,    bar_index + 12, sig_sl,    color=color.red,  width=2, style=line.style_solid)
    line.new(bar_index, sig_t1,    bar_index + 12, sig_t1,    color=color.green,width=2, style=line.style_solid)
    line.new(bar_index, sig_t2,    bar_index + 12, sig_t2,    color=color.teal, width=2, style=line.style_solid)

    label.new(bar_index + 12, sig_sl, "SL: " + str.tostring(sig_sl, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + 12, sig_t1, "T1: " + str.tostring(sig_t1, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + 12, sig_t2, "T2: " + str.tostring(sig_t2, "#.##"), color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.small)

// -----------------------------------------------------------------------------
// 6. ON-CHART HUD DASHBOARD TABLE
// -----------------------------------------------------------------------------
var table_pos = position.top_right
if dash_pos == "Bottom Right"
    table_pos := position.bottom_right
else if dash_pos == "Top Left"
    table_pos := position.top_left
else if dash_pos == "Bottom Left"
    table_pos := position.bottom_left

var table hud = table.new(table_pos, 2, 9, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_dash
    string sig_status = is_new_buy or (last_signal_dir == 1 and not is_new_sell) ? "STRONG BUY" : is_new_sell or (last_signal_dir == -1 and not is_new_buy) ? "STRONG SELL" : "WAITING / CHOP"
    color sig_color   = sig_status == "STRONG BUY" ? color.new(#10b981, 0) : sig_status == "STRONG SELL" ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0)

    table.cell(hud, 0, 0, "FinGroww Quant Radar", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "v5 Intelligence", bgcolor=color.new(#1e293b, 10), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 1, "Market Signal", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 1, sig_status, text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 2, "Confluence Score", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(confluence_power) + "% (Tier " + quality + ")", text_color=confluence_power >= 60 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    table.cell(hud, 0, 3, "Supertrend (10, 3)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 3, st_bull ? "BULLISH ▲" : "BEARISH ▼", text_color=st_bull ? color.green : color.red, text_size=size.small)

    table.cell(hud, 0, 4, "Trend Stack (EMA 9/21/50)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 4, trend_up ? "STRONG BULL" : trend_dn ? "STRONG BEAR" : "NEUTRAL / MIXED", text_color=trend_up ? color.green : trend_dn ? color.red : color.gray, text_size=size.small)

    table.cell(hud, 0, 5, "Session VWAP", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 5, above_vwap ? "ABOVE VWAP" : "BELOW VWAP", text_color=above_vwap ? color.green : color.red, text_size=size.small)

    table.cell(hud, 0, 6, "RSI (14) / ADX (14)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(rsi_val, "#.#") + " | ADX: " + str.tostring(adx_val, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 7, "Recent Entry", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 7, na(sig_entry) ? "—" : "₹" + str.tostring(sig_entry, "#.##"), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 8, "Target 1 / SL", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 8, na(sig_t1) ? "—" : "T1: " + str.tostring(sig_t1, "#.#") + " | SL: " + str.tostring(sig_sl, "#.#"), text_color=color.new(#facc15, 0), text_size=size.small)

// -----------------------------------------------------------------------------
// 7. TRADINGVIEW REAL-TIME AUTOMATED ALERTS
// -----------------------------------------------------------------------------
alertcondition(is_new_buy, title="FinGroww 95% BUY Signal", message="⚡ [FinGroww Radar] 95% Accuracy BUY Signal triggered on {{ticker}} at {{close}}!")
alertcondition(is_new_sell, title="FinGroww 95% SELL Signal", message="⚡ [FinGroww Radar] 95% Accuracy SELL Signal triggered on {{ticker}} at {{close}}!")
alertcondition(is_new_buy or is_new_sell, title="FinGroww Any Signal Alert", message="⚡ [FinGroww Radar] 95% Accuracy Confluence Signal on {{ticker}} at {{close}}!")
