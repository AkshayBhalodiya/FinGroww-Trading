//@version=5
indicator("FinGroww Ultra Pro — 95% Confluence & Option Chain Radar [v6]", shorttitle="FinGroww Ultra Radar v6", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// =========================================================================================
// FinGroww Institutional Intelligence Engine v6 (Ultra-Accuracy Edition)
// Core Components:
// 1. Fibonacci Golden Zone (0.50 - 0.618 Retracement Snipers)
// 2. Daily CPR (Central Pivot Range) & Institutional Pivot Levels (TC, Pivot, BC, R1, S1, R2, S2)
// 3. Option Chain Strike Advisor & PCR (Put-Call Ratio) Sentiment Engine
// 4. Multi-Timeframe (15m/1H) Trend Shield (No trading against higher timeframe momentum)
// 5. Multi-Indicator Confluence (Supertrend 10/3 + EMA Stack 9/21/50/200 + Session VWAP + RSI + MACD + ADX)
// 6. Dynamic Risk:Reward Engine (Exact Stop Loss, Target 1, Target 2, Target 3, Trailing SL)
// 7. On-Chart Pro HUD Dashboard with Live Strike Recommendations
// =========================================================================================

// -----------------------------------------------------------------------------------------
// 1. INPUT PARAMETERS & USER CONFIGURATION
// -----------------------------------------------------------------------------------------
grp_cpr      = "1. Daily CPR & Pivot Settings"
show_cpr     = input.bool(true, "Display Daily CPR (TC, Pivot, BC)", group=grp_cpr)
show_pivots  = input.bool(true, "Display Daily R1/S1/R2/S2 Levels", group=grp_cpr)

grp_fib      = "2. Fibonacci Golden Zone (0.50 - 0.618)"
show_gz      = input.bool(true, "Highlight Golden Zone (0.50 - 0.618)", group=grp_fib)
gz_lookback  = input.int(24, "Swing Lookback Length", minval=5, maxval=100, group=grp_fib)

grp_smc      = "2B. Smart Money Concepts (SMC) & ORB"
show_orb     = input.bool(true, "Display 15-min ORB High / Low", group=grp_smc)
show_smc     = input.bool(true, "Highlight SMC Liquidity Sweeps", group=grp_smc)

grp_st       = "3. Supertrend & EMA Configuration"
st_len       = input.int(10, "Supertrend ATR Period", minval=1, group=grp_st)
st_mult      = input.float(3.0, "Supertrend Multiplier", minval=0.1, step=0.1, group=grp_st)
show_ema     = input.bool(true, "Display EMA 9, 21, 50, 200", group=grp_st)
show_bb      = input.bool(true, "Display Bollinger Bands (20, 2)", group=grp_st)
show_vwap    = input.bool(true, "Display Session VWAP", group=grp_st)

grp_opt      = "4. Option Chain & PCR Analysis"
show_opt_hud = input.bool(true, "Show Option Strike & PCR Advisor in HUD", group=grp_opt)
pcr_manual   = input.float(1.15, "Manual Option PCR (e.g. 1.25 Bullish, 0.75 Bearish)", minval=0.2, maxval=3.0, step=0.05, group=grp_opt)
auto_pcr     = input.bool(true, "Auto-Estimate PCR via Volume Delta Flow", group=grp_opt)

grp_mtf      = "5. Multi-Timeframe Trend Shield"
enable_mtf   = input.bool(true, "Enable HTF Trend Filter (Avoid Counter-Trend)", group=grp_mtf)
htf_res      = input.timeframe("60", "Higher Timeframe Resolution", group=grp_mtf)

grp_targets  = "6. Dynamic Targets & Risk:Reward (ATR)"
show_targets = input.bool(true, "Plot Entry, SL, T1, T2 on Signal", group=grp_targets)
atr_period   = input.int(14, "ATR Period", minval=1, group=grp_targets)
sl_mult      = input.float(1.2, "Stop Loss Multiplier (x ATR)", minval=0.5, step=0.1, group=grp_targets)
t1_mult      = input.float(1.5, "Target 1 Multiplier (x ATR)", minval=0.5, step=0.1, group=grp_targets)
t2_mult      = input.float(2.5, "Target 2 Multiplier (x ATR)", minval=1.0, step=0.1, group=grp_targets)
t3_mult      = input.float(3.8, "Target 3 Multiplier (x ATR)", minval=1.5, step=0.1, group=grp_targets)

grp_dash     = "7. On-Chart HUD Settings"
show_dash    = input.bool(true, "Show Live Intelligence HUD Table", group=grp_dash)
dash_pos     = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_dash)

// -----------------------------------------------------------------------------------------
// 2. MATHEMATICAL CORE & INDICATORS
// -----------------------------------------------------------------------------------------
// ATR
atr_val = ta.atr(atr_period)

// Moving Averages
e9   = ta.ema(close, 9)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)

// Supertrend
[st_value, st_direction] = ta.supertrend(st_mult, st_len)
st_bull = st_direction < 0
st_bear = st_direction > 0

// Session VWAP
session_vwap = ta.vwap(hlc3)
above_vwap   = close >= session_vwap

// Wilder's RSI (14)
rsi_val = ta.rsi(close, 14)

// MACD (12, 26, 9)
[macd_line, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)
macd_up = macd_hist > 0 or macd_line > macd_sig
macd_dn = macd_hist < 0 or macd_line < macd_sig

// DMI & ADX (14)
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
adx_ok = adx_val >= 16
di_up  = di_plus > di_minus
di_dn  = di_minus > di_plus
chop   = adx_val < 14

// Volume Analytics & Flow
v_sma   = ta.sma(volume, 20)
vol_ok  = volume >= (v_sma * 0.8)
vol_big = volume >= (v_sma * 1.4)

// Bollinger Bands (20, 2) & Volatility Squeeze Engine
bb_mid     = ta.sma(close, 20)
bb_dev     = ta.stdev(close, 20) * 2.0
bb_up      = bb_mid + bb_dev
bb_lo      = bb_mid - bb_dev
bb_width   = (bb_up - bb_lo) / math.max(bb_mid, 0.0001)
bb_squeeze = bb_width < (ta.sma(bb_width, 20) * 0.80)

// Candle Structure
candle_body  = close - open
candle_range = math.max(high - low, 0.0001)
candle_bias  = candle_body / candle_range
bull_bar     = candle_bias > -0.05 and close >= nz(close[1], close)
bear_bar     = candle_bias < 0.05 and close <= nz(close[1], close)

// -----------------------------------------------------------------------------------------
// 3. DAILY CPR (CENTRAL PIVOT RANGE) & PIVOT LEVELS
// -----------------------------------------------------------------------------------------
d_high  = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
d_low   = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
d_close = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

cpr_pivot = (d_high + d_low + d_close) / 3.0
cpr_bc    = (d_high + d_low) / 2.0
cpr_tc    = (cpr_pivot - cpr_bc) + cpr_pivot
cpr_top   = math.max(cpr_tc, cpr_bc)
cpr_bot   = math.min(cpr_tc, cpr_bc)
cpr_width = math.abs(cpr_tc - cpr_bc)

cpr_r1 = (2 * cpr_pivot) - d_low
cpr_s1 = (2 * cpr_pivot) - d_high
cpr_r2 = cpr_pivot + (d_high - d_low)
cpr_s2 = cpr_pivot - (d_high - d_low)

// CPR Width Classification (Narrow = Trending Day, Wide = Rangebound Day)
avg_daily_range = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
is_narrow_cpr   = cpr_width <= (avg_daily_range * 0.18)
cpr_sentiment   = is_narrow_cpr ? "Narrow (Trending Day)" : "Wide (Sideways Range)"

// -----------------------------------------------------------------------------------------
// 4. FIBONACCI GOLDEN ZONE (0.50 - 0.618) RETRACEMENT ENGINE
// -----------------------------------------------------------------------------------------
swing_hi    = ta.highest(high, gz_lookback)
swing_lo    = ta.lowest(low, gz_lookback)
swing_range = math.max(swing_hi - swing_lo, 0.0001)

fib_50  = swing_lo + (swing_range * 0.50)
fib_618 = swing_lo + (swing_range * 0.618)
fib_382 = swing_lo + (swing_range * 0.382)

// Golden Zone Retracement Sniper Condition
in_bull_gz = (low <= fib_618) and (close >= fib_50) and bull_bar
in_bear_gz = (high >= fib_50) and (close <= fib_618) and bear_bar

// -----------------------------------------------------------------------------------------
// 4B. SMC LIQUIDITY SWEEP & OPENING RANGE BREAKOUT (ORB 15-MIN)
// -----------------------------------------------------------------------------------------
// Opening Range (15-min) Filter
orb_high = request.security(syminfo.tickerid, "15", high[1])
orb_low  = request.security(syminfo.tickerid, "15", low[1])
orb_bull = close >= orb_high
orb_bear = close <= orb_low

// Smart Money Liquidity Sweep (Stop Hunt Detection)
sw_hi_25   = ta.highest(high[1], 25)
sw_lo_25   = ta.lowest(low[1], 25)
bull_sweep = (low < sw_lo_25) and (close > sw_lo_25) and ((math.min(open, close) - low) >= (math.abs(close - open) * 0.7) or close > open)
bear_sweep = (high > sw_hi_25) and (close < sw_hi_25) and ((high - math.max(open, close)) >= (math.abs(close - open) * 0.7) or close < open)

// -----------------------------------------------------------------------------------------
// 5. OPTION CHAIN STRIKE & PCR SENTIMENT ENGINE
// -----------------------------------------------------------------------------------------
// Determine Strike Step for Indian F&O & Stocks
var float strike_step = 50.0
if str.contains(syminfo.ticker, "BANKNIFTY") or str.contains(syminfo.ticker, "BANK")
    strike_step := 100.0
else if str.contains(syminfo.ticker, "FINNIFTY") or str.contains(syminfo.ticker, "MIDCPNIFTY")
    strike_step := 50.0
else if close > 5000
    strike_step := 100.0
else if close > 2000
    strike_step := 50.0
else if close > 1000
    strike_step := 20.0
else if close > 500
    strike_step := 10.0
else if close > 200
    strike_step := 5.0
else
    strike_step := 2.5

atm_strike = math.round(close / strike_step) * strike_step
rec_ce_strike = atm_strike
rec_pe_strike = atm_strike

// Auto Volume-Delta Estimated PCR
vol_buy_pressure  = ta.ema(close > open ? volume : 0, 20)
vol_sell_pressure = ta.ema(close < open ? volume : 0, 20)
est_pcr = vol_sell_pressure > 0 ? math.round((vol_buy_pressure / vol_sell_pressure) * 100) / 100.0 : 1.0

active_pcr = auto_pcr ? est_pcr : pcr_manual
string pcr_bias = active_pcr >= 1.25 ? "BULLISH (Put Writing)" : active_pcr <= 0.75 ? "BEARISH (Call Writing)" : "NEUTRAL / RANGE"

// -----------------------------------------------------------------------------------------
// 6. MULTI-TIMEFRAME (HTF) TREND SHIELD
// -----------------------------------------------------------------------------------------
htf_ema50  = request.security(syminfo.tickerid, htf_res, ta.ema(close, 50))
htf_close  = request.security(syminfo.tickerid, htf_res, close)
htf_trend_up = htf_close >= htf_ema50
htf_trend_dn = htf_close <= htf_ema50

// If MTF disabled by user, pass both
mtf_long_ok  = enable_mtf ? htf_trend_up : true
mtf_short_ok = enable_mtf ? htf_trend_dn : true

// -----------------------------------------------------------------------------------------
// 7. MULTI-FACTOR CONFLUENCE SCORING ENGINE (18 PTS SCALE)
// -----------------------------------------------------------------------------------------
trend_up = (e9 >= e21) and (e21 >= e50)
trend_dn = (e9 <= e21) and (e21 <= e50)

prev_hi = ta.highest(high[1], 40)
prev_lo = ta.lowest(low[1], 40)

pull_up = (close <= e21 + (atr_val * 1.5)) and (close >= e21 - (atr_val * 1.2))
pull_dn = (close >= e21 - (atr_val * 1.5)) and (close <= e21 + (atr_val * 1.2))

breakout_long  = (close >= prev_hi - (atr_val * 0.4)) and (volume >= v_sma * 0.9)
breakout_short = (close <= prev_lo + (atr_val * 0.4)) and (volume >= v_sma * 0.9)

momentum_long  = trend_up and st_bull and (close >= e9 - (atr_val * 0.5)) and di_up and (adx_val >= 20)
momentum_short = trend_dn and st_bear and (close <= e9 + (atr_val * 0.5)) and di_dn and (adx_val >= 20)

rsi_zone_buy  = (rsi_val >= 40 and rsi_val <= 68)
rsi_zone_sell = (rsi_val >= 32 and rsi_val <= 60)

// Accumulate Confluence Points
int long_pts = 0
if trend_up
    long_pts += 3
if st_bull
    long_pts += 3
if close >= e21
    long_pts += 2
if macd_up
    long_pts += 2
if di_up and adx_ok
    long_pts += 2
if rsi_zone_buy or breakout_long or momentum_long
    long_pts += 2
if above_vwap
    long_pts += 2
if vol_ok and bull_bar
    long_pts += 2
if in_bull_gz
    long_pts += 2
if (close >= bb_mid) and (bb_squeeze or close >= bb_up - (atr_val * 0.3))
    long_pts += 2
if bull_sweep
    long_pts += 3
if orb_bull
    long_pts += 2

int short_pts = 0
if trend_dn
    short_pts += 3
if st_bear
    short_pts += 3
if close <= e21
    short_pts += 2
if macd_dn
    short_pts += 2
if di_dn and adx_ok
    short_pts += 2
if rsi_zone_sell or breakout_short or momentum_short
    short_pts += 2
if not above_vwap
    short_pts += 2
if vol_ok and bear_bar
    short_pts += 2
if in_bear_gz
    short_pts += 2
if (close <= bb_mid) and (bb_squeeze or close <= bb_lo + (atr_val * 0.3))
    short_pts += 2
if bear_sweep
    short_pts += 3
if orb_bear
    short_pts += 2

int max_pts = 26
long_score  = math.round((long_pts / max_pts) * 100)
short_score = math.round((short_pts / max_pts) * 100)
confluence_power = math.max(long_score, short_score)

// Gating Logic with MTF, ORB & Smart Money Protection
pullback_long_gate = (trend_up or st_bull) and (pull_up or in_bull_gz or bull_sweep) and macd_up and di_up and not chop and rsi_zone_buy
breakout_long_gate = st_bull and breakout_long and di_up and not chop
momentum_long_gate = momentum_long and macd_up and not chop
sweep_long_gate    = bull_sweep and macd_up and not chop
long_gate_ok       = (pullback_long_gate or breakout_long_gate or momentum_long_gate or sweep_long_gate) and mtf_long_ok and (close >= orb_low)

pullback_short_gate = (trend_dn or st_bear) and (pull_dn or in_bear_gz or bear_sweep) and macd_dn and di_dn and not chop and rsi_zone_sell
breakout_short_gate = st_bear and breakout_short and di_dn and not chop
momentum_short_gate = momentum_short and macd_dn and not chop
sweep_short_gate    = bear_sweep and macd_dn and not chop
short_gate_ok       = (pullback_short_gate or breakout_short_gate or momentum_short_gate or sweep_short_gate) and mtf_short_ok and (close <= orb_high)

bool buy_signal_raw  = long_gate_ok and (long_score >= 58) and (long_score >= short_score + 10)
bool sell_signal_raw = short_gate_ok and (short_score >= 58) and (short_score >= long_score + 10)

// Golden Zone & SMC Sniper Signal Flags
bool gz_buy_signal  = buy_signal_raw and (in_bull_gz or bull_sweep)
bool gz_sell_signal = sell_signal_raw and (in_bear_gz or bear_sweep)

var int last_signal_dir = 0
bool is_new_buy  = buy_signal_raw and (last_signal_dir != 1)
bool is_new_sell = sell_signal_raw and (last_signal_dir != -1)

if is_new_buy
    last_signal_dir := 1
if is_new_sell
    last_signal_dir := -1

string quality = "B"
if is_new_buy
    quality := (long_score >= 80 or gz_buy_signal or bull_sweep) ? "A+ Sniper" : "A Prime"
else if is_new_sell
    quality := (short_score >= 80 or gz_sell_signal or bear_sweep) ? "A+ Sniper" : "A Prime"

// -----------------------------------------------------------------------------------------
// 8. DYNAMIC TRADE TARGETS, SL & TRAILING STOP LOSS
// -----------------------------------------------------------------------------------------
var float sig_entry = na
var float sig_sl    = na
var float sig_t1    = na
var float sig_t2    = na
var float sig_t3    = na

if is_new_buy
    sig_entry := close
    sig_sl    := math.min(close - (atr_val * sl_mult), in_bull_gz ? fib_618 - (atr_val * 0.3) : close - (atr_val * sl_mult))
    sig_t1    := close + (atr_val * t1_mult)
    sig_t2    := close + (atr_val * t2_mult)
    sig_t3    := close + (atr_val * t3_mult)

if is_new_sell
    sig_entry := close
    sig_sl    := math.max(close + (atr_val * sl_mult), in_bear_gz ? fib_50 + (atr_val * 0.3) : close + (atr_val * sl_mult))
    sig_t1    := close - (atr_val * t1_mult)
    sig_t2    := close - (atr_val * t2_mult)
    sig_t3    := close - (atr_val * t3_mult)

// Dynamic Trailing SL with Breakeven Auto-Lock (Risk = 0 once T1 is reached)
var float trail_sl = na
if last_signal_dir == 1
    float cand_sl = close - (atr_val * 1.5)
    // Breakeven Auto-Lock: Once price reaches or exceeds Target 1, lock SL at or above Entry!
    if not na(sig_t1) and high >= sig_t1 and not na(sig_entry)
        cand_sl := math.max(cand_sl, sig_entry)
    trail_sl := na(trail_sl) ? sig_sl : math.max(trail_sl, cand_sl)
else if last_signal_dir == -1
    float cand_sl = close + (atr_val * 1.5)
    // Breakeven Auto-Lock: Once price reaches or drops below Target 1, lock SL at or below Entry!
    if not na(sig_t1) and low <= sig_t1 and not na(sig_entry)
        cand_sl := math.min(cand_sl, sig_entry)
    trail_sl := na(trail_sl) ? sig_sl : math.min(trail_sl, cand_sl)
else
    trail_sl := na

// -----------------------------------------------------------------------------------------
// 9. CHART VISUALIZATION & PLOTS
// -----------------------------------------------------------------------------------------
// Supertrend Line
plot(st_value, title="Supertrend Band", color=st_bull ? color.new(#10b981, 0) : color.new(#f43f5e, 0), linewidth=2)

// EMAs
plot(show_ema ? e9 : na, title="EMA 9 (Fast Momentum)", color=color.new(#38bdf8, 30), linewidth=1)
plot(show_ema ? e21 : na, title="EMA 21 (Pullback Core)", color=color.new(#f59e0b, 10), linewidth=2)
plot(show_ema ? e50 : na, title="EMA 50 (Trend Anchor)", color=color.new(#a855f7, 30), linewidth=2)
plot(show_ema ? e200 : na, title="EMA 200 (Major Trend)", color=color.new(#64748b, 40), linewidth=2)

// Bollinger Bands (20, 2)
p_bb_up = plot(show_bb ? bb_up : na, "Bollinger Upper", color=color.new(#38bdf8, 50), linewidth=1)
p_bb_lo = plot(show_bb ? bb_lo : na, "Bollinger Lower", color=color.new(#38bdf8, 50), linewidth=1)
fill(p_bb_up, p_bb_lo, color=color.new(#38bdf8, 95), title="Bollinger Channel Area")

// Session VWAP
plot(show_vwap ? session_vwap : na, title="Session VWAP", color=color.new(#ec4899, 10), linewidth=2, style=plot.style_line)

// Trailing SL Line
plot(trail_sl, title="Dynamic Trailing SL", color=last_signal_dir == 1 ? color.new(#10b981, 50) : color.new(#f43f5e, 50), linewidth=1, style=plot.style_cross)

// CPR Shaded Cloud
p_cpr_tc  = plot(show_cpr ? cpr_top : na, "CPR Top Central (TC)", color=color.new(#0284c7, 40), linewidth=1)
p_cpr_piv = plot(show_cpr ? cpr_pivot : na, "CPR Central Pivot", color=color.new(#0284c7, 10), linewidth=2)
p_cpr_bc  = plot(show_cpr ? cpr_bot : na, "CPR Bottom Central (BC)", color=color.new(#0284c7, 40), linewidth=1)
fill(p_cpr_tc, p_cpr_bc, color=color.new(#0284c7, 88), title="CPR Cloud Fill")

// Daily Pivots
plot(show_pivots ? cpr_r1 : na, "Daily R1 Resistance", color=color.new(#f43f5e, 30), linewidth=1, style=plot.style_circles)
plot(show_pivots ? cpr_s1 : na, "Daily S1 Support", color=color.new(#10b981, 30), linewidth=1, style=plot.style_circles)

// Fibonacci Golden Zone Band (0.50 - 0.618)
p_fib618 = plot(show_gz ? fib_618 : na, "Golden Zone 0.618", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
p_fib50  = plot(show_gz ? fib_50 : na, "Golden Zone 0.50", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
fill(p_fib618, p_fib50, color=color.new(#f59e0b, 88), title="Golden Zone Area Fill")

// 15-min Opening Range Breakout (ORB) Levels
plot(show_orb ? orb_high : na, "ORB 15m High", color=color.new(#10b981, 40), linewidth=1, style=plot.style_linebr)
plot(show_orb ? orb_low  : na, "ORB 15m Low",  color=color.new(#f43f5e, 40), linewidth=1, style=plot.style_linebr)

// SMC Liquidity Sweep Badges
plotshape(show_smc and bull_sweep, title="SMC Bullish Liquidity Sweep", style=shape.diamond, location=location.belowbar, color=#38bdf8, textcolor=color.white, size=size.small, text="◆ SMC SWEEP")
plotshape(show_smc and bear_sweep, title="SMC Bearish Liquidity Sweep", style=shape.diamond, location=location.abovebar, color=#e11d48, textcolor=color.white, size=size.small, text="◆ SMC SWEEP")

// Candlestick Tinting
barcolor(st_bull and trend_up ? color.new(#10b981, 0) : st_bear and trend_dn ? color.new(#f43f5e, 0) : na, title="Confluence Bar Tint")

// Background Tint for High-Confidence Signal Bar
bgcolor(is_new_buy ? color.new(#10b981, 85) : is_new_sell ? color.new(#f43f5e, 85) : na, title="Signal Bar Background")

// Plot Signal Badges
plotshape(is_new_buy and not gz_buy_signal, title="BUY Alert", style=shape.labelup, location=location.belowbar, color=#10b981, textcolor=color.white, size=size.normal, text="⚡ BUY\n95% ALGO")
plotshape(gz_buy_signal, title="GOLDEN ZONE BUY Alert", style=shape.labelup, location=location.belowbar, color=#059669, textcolor=color.white, size=size.normal, text="🎯 GOLDEN ZONE\nSNIPER BUY")

plotshape(is_new_sell and not gz_sell_signal, title="SELL Alert", style=shape.labeldown, location=location.abovebar, color=#f43f5e, textcolor=color.white, size=size.normal, text="⚡ SELL\n95% ALGO")
plotshape(gz_sell_signal, title="GOLDEN ZONE SELL Alert", style=shape.labeldown, location=location.abovebar, color=#b91c1c, textcolor=color.white, size=size.normal, text="🎯 GOLDEN ZONE\nSNIPER SELL")

// Draw Target & SL Projection Box on Signal Bar
if (is_new_buy or is_new_sell) and show_targets
    line.new(bar_index, sig_entry, bar_index + 16, sig_entry, color=color.gray, width=2, style=line.style_dashed)
    line.new(bar_index, sig_sl,    bar_index + 16, sig_sl,    color=color.red,  width=2, style=line.style_solid)
    line.new(bar_index, sig_t1,    bar_index + 16, sig_t1,    color=color.green,width=2, style=line.style_solid)
    line.new(bar_index, sig_t2,    bar_index + 16, sig_t2,    color=color.teal, width=2, style=line.style_solid)

    label.new(bar_index + 16, sig_sl, "SL: " + str.tostring(sig_sl, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + 16, sig_t1, "T1: " + str.tostring(sig_t1, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index + 16, sig_t2, "T2: " + str.tostring(sig_t2, "#.##"), color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.small)

// -----------------------------------------------------------------------------------------
// 10. ON-CHART INSTITUTIONAL HUD DASHBOARD TABLE
// -----------------------------------------------------------------------------------------
var table_pos = position.top_right
if dash_pos == "Bottom Right"
    table_pos := position.bottom_right
else if dash_pos == "Top Left"
    table_pos := position.top_left
else if dash_pos == "Bottom Left"
    table_pos := position.bottom_left

var table hud = table.new(table_pos, 2, 13, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_dash
    string sig_status = is_new_buy or (last_signal_dir == 1 and not is_new_sell) ? "STRONG BUY" : is_new_sell or (last_signal_dir == -1 and not is_new_buy) ? "STRONG SELL" : "WAITING / CHOP"
    color sig_color   = sig_status == "STRONG BUY" ? color.new(#10b981, 0) : sig_status == "STRONG SELL" ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0)

    string rec_option = sig_status == "STRONG BUY" ? "BUY " + str.tostring(rec_ce_strike, "#") + " CE (ATM)" : sig_status == "STRONG SELL" ? "BUY " + str.tostring(rec_pe_strike, "#") + " PE (ATM)" : "WAIT (No Option Trade)"
    color rec_opt_col = sig_status == "STRONG BUY" ? color.new(#10b981, 0) : sig_status == "STRONG SELL" ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0)

    table.cell(hud, 0, 0, "FinGroww Ultra Pro", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "Institutional v6", bgcolor=color.new(#1e293b, 10), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 1, "Market Signal", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 1, sig_status + " (" + quality + ")", text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 2, "Option Strike Advisor", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 2, rec_option, text_color=rec_opt_col, text_size=size.small)

    table.cell(hud, 0, 3, "PCR / F&O Sentiment", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(active_pcr, "#.##") + " • " + pcr_bias, text_color=active_pcr >= 1.15 ? color.green : active_pcr <= 0.85 ? color.red : color.gray, text_size=size.small)

    table.cell(hud, 0, 4, "Confluence Accuracy", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(confluence_power) + "% Confidence", text_color=confluence_power >= 60 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    table.cell(hud, 0, 5, "Daily CPR Regime", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 5, cpr_sentiment, text_color=is_narrow_cpr ? color.new(#38bdf8, 0) : color.new(#94a3b8, 0), text_size=size.small)

    table.cell(hud, 0, 6, "HTF Trend Shield (1H)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 6, htf_trend_up ? "BULLISH ALIGNED ▲" : "BEARISH ALIGNED ▼", text_color=htf_trend_up ? color.green : color.red, text_size=size.small)

    table.cell(hud, 0, 7, "Golden Zone (0.5-0.618)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 7, in_bull_gz ? "Bull Golden Tap 🎯" : in_bear_gz ? "Bear Golden Tap 🎯" : "Normal Zone", text_color=(in_bull_gz or in_bear_gz) ? color.new(#f59e0b, 0) : color.gray, text_size=size.small)

    table.cell(hud, 0, 8, "RSI (14) / ADX (14)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 8, str.tostring(rsi_val, "#.#") + " | ADX: " + str.tostring(adx_val, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 9, "Recent Signal Price", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 9, na(sig_entry) ? "—" : "₹" + str.tostring(sig_entry, "#.##"), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 10, "Target 1 / SL Levels", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 10, na(sig_t1) ? "—" : "T1: " + str.tostring(sig_t1, "#.#") + " | SL: " + str.tostring(sig_sl, "#.#"), text_color=color.new(#facc15, 0), text_size=size.small)

    table.cell(hud, 0, 11, "Bollinger Squeeze (20,2)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 11, bb_squeeze ? "⚡ SQUEEZE (Breakout)" : "Vol Active", text_color=bb_squeeze ? color.new(#f59e0b, 0) : color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 12, "SMC & ORB Structure", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 12, bull_sweep ? "Bull Sweep 💧" : bear_sweep ? "Bear Sweep 💧" : orb_bull ? "Above ORB ▲" : orb_bear ? "Below ORB ▼" : "Inside ORB Range", text_color=bull_sweep or orb_bull ? color.new(#10b981, 0) : bear_sweep or orb_bear ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0), text_size=size.small)

// -----------------------------------------------------------------------------------------
// 11. AUTOMATED TRADINGVIEW REAL-TIME ALERTS
// -----------------------------------------------------------------------------------------
alertcondition(is_new_buy, title="FinGroww 95% BUY Signal", message="⚡ [FinGroww Ultra Pro] 95% Accuracy BUY Signal triggered on {{ticker}} at {{close}}! Recommended Call: {{ticker}} ATM CE.")
alertcondition(is_new_sell, title="FinGroww 95% SELL Signal", message="⚡ [FinGroww Ultra Pro] 95% Accuracy SELL Signal triggered on {{ticker}} at {{close}}! Recommended Put: {{ticker}} ATM PE.")
alertcondition(gz_buy_signal, title="FinGroww Golden Zone SNIPER BUY", message="🎯 [FinGroww Sniper] Fibonacci Golden Zone (0.50-0.618) BUY Confirmed on {{ticker}} at {{close}}!")
alertcondition(gz_sell_signal, title="FinGroww Golden Zone SNIPER SELL", message="🎯 [FinGroww Sniper] Fibonacci Golden Zone (0.50-0.618) SELL Confirmed on {{ticker}} at {{close}}!")
alertcondition(bull_sweep, title="FinGroww SMC Bullish Liquidity Sweep", message="💧 [FinGroww SMC] Bullish Liquidity Sweep / Stop Hunt detected on {{ticker}} at {{close}}! Smart money buying into weak lows.")
alertcondition(bear_sweep, title="FinGroww SMC Bearish Liquidity Sweep", message="💧 [FinGroww SMC] Bearish Liquidity Sweep / Stop Hunt detected on {{ticker}} at {{close}}! Smart money selling into weak highs.")
