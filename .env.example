# ==========================================================================
# FinGroww SaaS Platform — Environment Configuration Template
# Copy to .env and populate production secrets before deployment.
# ==========================================================================

ENVIRONMENT=production
PORT=10000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/fingroww_db?retryWrites=true&w=majority
MONGODB_DB_NAME=fingroww_db

# Cryptographic Signing & Encryption Keys (Use 32+ random characters in production)
JWT_SECRET_KEY=replace_with_64_char_cryptographically_random_secret_key
SECRET_ENCRYPTION_KEY=replace_with_32_char_encryption_secret_key
PAYMENT_WEBHOOK_SECRET=replace_with_payment_gateway_hmac_webhook_secret

# Google OAuth2 Sign-In
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Transactional Email (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
FRONTEND_URL=https://fingroww.tech

# Live Broker API Keys (Optional server-side master fallbacks)
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=https://api.fingroww.tech/api/real-algo/upstox/callback
