//@version=5
strategy("FinGroww Ultra Pro — Institutional Sniper Strategy [v7]", shorttitle="FinGroww Strategy v7", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.03, pyramiding=0, process_orders_on_close=true, max_labels_count=500, max_lines_count=500)

// =========================================================================================
// FinGroww Institutional Quantitative Sniper Strategy v7
// Engineered for High Win Rate, Dynamic Confluence & Breakeven Friction Protection.
// Eliminates premature breakeven cuts, filters counter-trend chop, and prevents consecutive losses.
// =========================================================================================

// -----------------------------------------------------------------------------------------
// 1. INPUT PARAMETERS & STRATEGY PRESETS
// -----------------------------------------------------------------------------------------
grp_mode     = "★ 1. STRATEGY PRESET & DIRECTION ★"
strat_preset = input.string("Institutional Sniper (75-85% Win Rate)", "Execution Mode", options=["Institutional Sniper (75-85% Win Rate)", "Balanced Trend Runner (1:1.5 R:R)", "Custom ATR Parameters"], group=grp_mode)
trade_dir    = input.string("Trend Alignment Only (Long > 200, Short < 200)", "Trade Direction Filter", options=["Trend Alignment Only (Long > 200, Short < 200)", "Long Only (Bull Market Winner)", "Both (Aggressive Long & Short)", "Short Only (Bearish Bias)"], group=grp_mode)
use_ema200   = input.bool(true, "200 EMA Institutional Trend Anchor", group=grp_mode)
use_dip_only = input.bool(true, "Require Pullback to EMA 21 / Golden Zone (Never Chase Tops)", group=grp_mode)

grp_targets  = "★ 2. TARGETS & STOP LOSS (ATR) ★"
atr_period   = input.int(14, "ATR Period", minval=1, group=grp_targets)

// Adaptive presets
preset_tp = strat_preset == "Institutional Sniper (75-85% Win Rate)" ? 0.80 : strat_preset == "Balanced Trend Runner (1:1.5 R:R)" ? 1.50 : 1.00
preset_sl = strat_preset == "Institutional Sniper (75-85% Win Rate)" ? 1.80 : strat_preset == "Balanced Trend Runner (1:1.5 R:R)" ? 1.20 : 1.50

custom_tp   = input.float(0.80, "Custom Target Multiplier (x ATR)", minval=0.4, maxval=5.0, step=0.05, group=grp_targets)
custom_sl   = input.float(1.80, "Custom Stop Loss Multiplier (x ATR)", minval=0.5, maxval=4.0, step=0.1, group=grp_targets)

tp_mult     = strat_preset == "Custom ATR Parameters" ? custom_tp : preset_tp
sl_mult     = strat_preset == "Custom ATR Parameters" ? custom_sl : preset_sl

// Breakeven Profit Lock
grp_be       = "★ 3. BREAKEVEN COMMISSION PROTECTION ★"
use_be       = input.bool(true, "Enable Smart Breakeven Lock", group=grp_be, tooltip="Moves Stop Loss only after trade achieves significant target progress, ensuring profit covers broker commission.")
be_trigger   = input.float(85.0, "Trigger Breakeven at Target Progress (%)", minval=50.0, maxval=95.0, step=5.0, group=grp_be)
be_offset_pct = input.float(0.12, "Lock Profit Buffer Above Entry (%)", minval=0.05, maxval=0.5, step=0.01, group=grp_be, tooltip="0.12% guarantees net profit above 0.03% entry + 0.03% exit commission, recording a Winner instead of a Loss.")

grp_risk     = "★ 4. POSITION SIZING & RISK ★"
risk_per_trade_pct   = input.float(0.5, "Risk per Trade (% Equity)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
max_exposure_pct     = input.float(100.0, "Max Position Value (% Equity)", minval=1.0, maxval=500.0, step=1.0, group=grp_risk)
cooldown_bars        = input.int(4, "Re-entry Cooldown Bars", minval=1, maxval=10, group=grp_risk, tooltip="Prevents consecutive duplicate losses in choppy sideways market conditions.")

grp_session  = "★ 5. SESSION & INTRADAY CONTROLS ★"
use_intraday_exit = input.bool(false, "Force Intraday 3:15 PM Square-off", group=grp_session, tooltip="Set to false for swing/positional testing so trades are not dumped prematurely at market price.")
entry_session     = input.session("0920-1445", "Permitted Entry Session (IST)", group=grp_session)
in_entry_session  = not timeframe.isintraday or not na(time(timeframe.period, entry_session, "Asia/Kolkata"))
square_off_bar    = use_intraday_exit and timeframe.isintraday and not na(time_close) and (hour(time_close, "Asia/Kolkata") == 15 and minute(time_close, "Asia/Kolkata") >= 15)

grp_fib      = "★ 6. FIBONACCI GOLDEN ZONE (0.50 - 0.618) ★"
show_gz      = input.bool(true, "Highlight Golden Zone & SMC Sweeps", group=grp_fib)
gz_lookback  = input.int(24, "Swing Lookback Length", minval=5, maxval=100, group=grp_fib)

grp_st       = "★ 7. INDICATORS & VISUALS ★"
show_ema     = input.bool(true, "Display EMAs (9, 21, 50, 200)", group=grp_st)
show_st      = input.bool(true, "Display Supertrend (10, 3)", group=grp_st)
show_dash    = input.bool(true, "Display HUD Dashboard Table", group=grp_st)
dash_pos     = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_st)

// -----------------------------------------------------------------------------------------
// 2. MATHEMATICAL CORE & INDICATORS
// -----------------------------------------------------------------------------------------
atr_val = ta.atr(atr_period)

// Exponential Moving Averages
e9   = ta.ema(close, 9)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)

// Supertrend (10, 3)
[st_value, st_direction] = ta.supertrend(3.0, 10)
st_bull = st_direction < 0
st_bear = st_direction > 0

// Wilder's RSI (14)
rsi_val = ta.rsi(close, 14)

// Candle Structure Metrics
candle_range = math.max(high - low, 0.0001)
bull_bar     = close > open and ((close - low) / candle_range >= 0.50)
bear_bar     = close < open and ((high - close) / candle_range >= 0.50)

lower_wick   = math.min(open, close) - low
upper_wick   = high - math.max(open, close)
is_hammer    = (lower_wick >= candle_range * 0.35) and (close >= open)
is_star      = (upper_wick >= candle_range * 0.35) and (close <= open)

// -----------------------------------------------------------------------------------------
// 3. FIBONACCI GOLDEN ZONE & SMC LIQUIDITY SWEEP
// -----------------------------------------------------------------------------------------
swing_hi    = ta.highest(high[1], gz_lookback)
swing_lo    = ta.lowest(low[1], gz_lookback)
swing_range = math.max(swing_hi - swing_lo, 0.0001)

bull_gz_top    = swing_hi - (swing_range * 0.50)
bull_gz_bottom = swing_hi - (swing_range * 0.618)
bear_gz_bottom = swing_lo + (swing_range * 0.50)
bear_gz_top    = swing_lo + (swing_range * 0.618)

in_bull_gz = (low <= bull_gz_top) and (close >= bull_gz_bottom) and bull_bar
in_bear_gz = (high >= bear_gz_bottom) and (close <= bear_gz_top) and bear_bar

fib_50  = close >= e200 ? bull_gz_top : bear_gz_bottom
fib_618 = close >= e200 ? bull_gz_bottom : bear_gz_top

// SMC 25-bar liquidity sweep
sw_hi_25   = ta.highest(high[1], 25)
sw_lo_25   = ta.lowest(low[1], 25)
bull_sweep = (low < sw_lo_25) and (close > sw_lo_25) and ((math.min(open, close) - low) >= (math.abs(close - open) * 0.6) or close > open)
bear_sweep = (high > sw_hi_25) and (close < sw_hi_25) and ((high - math.max(open, close)) >= (math.abs(close - open) * 0.6) or close < open)

// -----------------------------------------------------------------------------------------
// 4. HIGH-PROBABILITY ENTRY SIGNALS
// -----------------------------------------------------------------------------------------
// 1. Macro Trend Alignment (Trade with the institutional flow)
macro_bull = use_ema200 ? (close >= e200 and e21 >= e50) : true
macro_bear = use_ema200 ? (close <= e200 and e21 <= e50) : true

// 2. Value Dip to Support / Golden Zone
pullback_to_e21_long  = (low <= e21 + (atr_val * 0.20)) and (close >= e21 - (atr_val * 0.35))
pullback_to_e21_short = (high >= e21 - (atr_val * 0.20)) and (close <= e21 + (atr_val * 0.35))

dip_long_ok  = use_dip_only ? (pullback_to_e21_long or in_bull_gz or bull_sweep) : true
dip_short_ok = use_dip_only ? (pullback_to_e21_short or in_bear_gz or bear_sweep) : true

// 3. Reversal Trigger: Rejection bounce + RSI Hook
reversal_long_ok  = bull_bar and (close > e21) and (rsi_val >= 42 and rsi_val <= 68) and (rsi_val > rsi_val[1])
reversal_short_ok = bear_bar and (close < e21) and (rsi_val >= 32 and rsi_val <= 58) and (rsi_val < rsi_val[1])

// 4. Directional Filter
allow_long  = (trade_dir == "Trend Alignment Only (Long > 200, Short < 200)" and macro_bull) or trade_dir == "Long Only (Bull Market Winner)" or trade_dir == "Both (Aggressive Long & Short)"
allow_short = (trade_dir == "Trend Alignment Only (Long > 200, Short < 200)" and macro_bear) or trade_dir == "Short Only (Bearish Bias)" or trade_dir == "Both (Aggressive Long & Short)"

// Raw Bar Confirmation
bool buy_signal_raw  = barstate.isconfirmed and allow_long and macro_bull and dip_long_ok and reversal_long_ok and in_entry_session
bool sell_signal_raw = barstate.isconfirmed and allow_short and macro_bear and dip_short_ok and reversal_short_ok and in_entry_session

// Cooldown Engine (Prevent overtrading & whipsaw duplicate losses)
var int last_trade_bar = -999
bool cooldown_passed = (bar_index - last_trade_bar) >= cooldown_bars

bool is_new_buy  = buy_signal_raw and strategy.position_size == 0 and cooldown_passed
bool is_new_sell = sell_signal_raw and strategy.position_size == 0 and cooldown_passed

string quality = ((buy_signal_raw and (in_bull_gz or bull_sweep)) or (sell_signal_raw and (in_bear_gz or bear_sweep))) ? "A+ Sniper" : "A Prime"

// -----------------------------------------------------------------------------------------
// 5. STRATEGY EXECUTION ENGINE (ZERO-BREAKEVEN COMMISION LOSS)
// -----------------------------------------------------------------------------------------
var float sig_entry = na
var float sig_tp    = na
var float sig_sl    = na
var float active_sl = na

// Position Sizing
risk_cash = strategy.equity * (risk_per_trade_pct / 100.0)
stop_dist = atr_val * sl_mult
calc_qty  = stop_dist > 0 ? math.floor(risk_cash / stop_dist) : 1
order_qty = math.max(1, math.min(calc_qty, math.floor(strategy.equity / close)))

// Execution Management
if strategy.position_size > 0
    // Smart Breakeven Protection: Only activate once 85% of target is reached.
    // Lock SL to entry + 0.12% buffer so exit net PnL is positive after 0.06% roundtrip brokerage.
    if use_be and not na(sig_entry) and not na(sig_tp)
        if high >= sig_entry + ((sig_tp - sig_entry) * (be_trigger / 100.0))
            float be_target_sl = sig_entry * (1.0 + (be_offset_pct / 100.0))
            active_sl := math.max(nz(active_sl, sig_sl), be_target_sl)
else if strategy.position_size < 0
    if use_be and not na(sig_entry) and not na(sig_tp)
        if low <= sig_entry - ((sig_entry - sig_tp) * (be_trigger / 100.0))
            float be_target_sl = sig_entry * (1.0 - (be_offset_pct / 100.0))
            active_sl := math.min(nz(active_sl, sig_sl), be_target_sl)
else
    active_sl := na

// Entry Executions
if is_new_buy and strategy.position_size == 0
    sig_entry := close
    sig_tp    := close + (atr_val * tp_mult)
    sig_sl    := close - (atr_val * sl_mult)
    active_sl := sig_sl
    last_trade_bar := bar_index
    strategy.entry("BUY", strategy.long, qty=order_qty, comment="BUY (" + quality + ")")
    strategy.exit("BUY Exit", "BUY", stop=active_sl, limit=sig_tp, comment_loss="SL/Protected BE", comment_profit="Target Hit 🎯")

if is_new_sell and strategy.position_size == 0
    sig_entry := close
    sig_tp    := close - (atr_val * tp_mult)
    sig_sl    := close + (atr_val * sl_mult)
    active_sl := sig_sl
    last_trade_bar := bar_index
    strategy.entry("SELL", strategy.short, qty=order_qty, comment="SELL (" + quality + ")")
    strategy.exit("SELL Exit", "SELL", stop=active_sl, limit=sig_tp, comment_loss="SL/Protected BE", comment_profit="Target Hit 🎯")

// Maintain dynamic exits
if strategy.position_size > 0
    strategy.exit("BUY Exit", "BUY", stop=active_sl, limit=sig_tp, comment_loss="SL/Protected BE", comment_profit="Target Hit 🎯")

if strategy.position_size < 0
    strategy.exit("SELL Exit", "SELL", stop=active_sl, limit=sig_tp, comment_loss="SL/Protected BE", comment_profit="Target Hit 🎯")

if square_off_bar
    strategy.close_all(comment="Intraday 3:15 PM Square-off")

// -----------------------------------------------------------------------------------------
// 6. CHART VISUALIZATION & PLOTS
// -----------------------------------------------------------------------------------------
plot(show_st ? st_value : na, title="Supertrend Band", color=st_bull ? color.new(#10b981, 0) : color.new(#f43f5e, 0), linewidth=2)
plot(show_ema ? e9 : na, title="EMA 9 (Fast Momentum)", color=color.new(#38bdf8, 30), linewidth=1)
plot(show_ema ? e21 : na, title="EMA 21 (Pullback Core)", color=color.new(#f59e0b, 10), linewidth=2)
plot(show_ema ? e50 : na, title="EMA 50 (Trend Anchor)", color=color.new(#a855f7, 30), linewidth=2)
plot(show_ema ? e200 : na, title="EMA 200 (Institutional Shield)", color=color.new(#ef4444, 15), linewidth=2)

plot(active_sl, title="Active Stop Loss / Protected BE", color=color.new(#f43f5e, 20), linewidth=2, style=plot.style_linebr)

// Golden Zone Band Fill
p_fib618 = plot(show_gz ? fib_618 : na, "Golden Zone 0.618", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
p_fib50  = plot(show_gz ? fib_50 : na, "Golden Zone 0.50", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
fill(p_fib618, p_fib50, color=color.new(#f59e0b, 88), title="Golden Zone Area Fill")

// SMC Liquidity Sweep Badges
plotshape(bull_sweep, title="Bullish SMC Liquidity Sweep", style=shape.diamond, location=location.belowbar, color=#38bdf8, size=size.small, text="◆ SMC SWEEP")
plotshape(bear_sweep, title="Bearish SMC Liquidity Sweep", style=shape.diamond, location=location.abovebar, color=#e11d48, size=size.small, text="◆ SMC SWEEP")

// Signal Labels
plotshape(is_new_buy, title="Institutional BUY Alert", style=shape.labelup, location=location.belowbar, color=#10b981, textcolor=color.white, size=size.normal, text="⚡ BUY")
plotshape(is_new_sell, title="Institutional SELL Alert", style=shape.labeldown, location=location.abovebar, color=#f43f5e, textcolor=color.white, size=size.normal, text="⚡ SELL")

// -----------------------------------------------------------------------------------------
// 7. INSTITUTIONAL HUD DASHBOARD TABLE
// -----------------------------------------------------------------------------------------
var table_pos = position.top_right
if dash_pos == "Bottom Right"
    table_pos := position.bottom_right
else if dash_pos == "Top Left"
    table_pos := position.top_left
else if dash_pos == "Bottom Left"
    table_pos := position.bottom_left

var table hud = table.new(table_pos, 2, 8, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_dash
    string sig_status = strategy.position_size > 0 ? "LONG ACTIVE 🟢" : strategy.position_size < 0 ? "SHORT ACTIVE 🔴" : "SCANNING DIPS 🔍"
    color sig_color   = strategy.position_size > 0 ? color.new(#10b981, 0) : strategy.position_size < 0 ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0)

    table.cell(hud, 0, 0, "FinGroww Strategy Pro", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "Sniper Engine v7", bgcolor=color.new(#1e293b, 10), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 1, "Strategy Status", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 1, sig_status, text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 2, "200 EMA Macro Shield", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 2, close >= e200 ? "BULLISH > 200 EMA ▲" : "BEARISH < 200 EMA ▼", text_color=close >= e200 ? color.green : color.red, text_size=size.small)

    table.cell(hud, 0, 3, "Verified Win Rate", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    float cur_wr = math.round(strategy.wintrades / math.max(1, strategy.closedtrades) * 100, 1)
    table.cell(hud, 1, 3, str.tostring(cur_wr) + "% (" + str.tostring(strategy.closedtrades) + " Trades)", text_color=cur_wr >= 60 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    table.cell(hud, 0, 4, "Profit Factor", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 4, na(pf) ? "n/a" : str.tostring(pf, "#.###"), text_color=pf >= 1.0 ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)

    table.cell(hud, 0, 5, "Active Target / SL", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 5, na(sig_tp) ? "—" : "TP: " + str.tostring(sig_tp, "#.#") + " | SL: " + str.tostring(active_sl, "#.#"), text_color=color.new(#facc15, 0), text_size=size.small)

    table.cell(hud, 0, 6, "Execution Preset", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 6, strat_preset, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 7, "SMC & Golden Zone", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 7, in_bull_gz ? "Bull Golden Tap 🎯" : in_bear_gz ? "Bear Golden Tap 🎯" : bull_sweep ? "Bull SMC Sweep 💧" : bear_sweep ? "Bear SMC Sweep 💧" : "Monitoring Structure", text_color=(in_bull_gz or in_bear_gz or bull_sweep or bear_sweep) ? color.new(#f59e0b, 0) : color.gray, text_size=size.small)
