//@version=5
strategy("FinGroww Ultra Pro — Trend Pullback Strategy [v6]", shorttitle="FinGroww Strategy v6", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.03, pyramiding=0, process_orders_on_close=true, max_labels_count=500, max_lines_count=500)

// =========================================================================================
// FinGroww Trend Pullback Strategy v6.
// Signals combine macro trend, EMA alignment, pullback/reversal, and configurable confluence filters.
// Backtest results vary by symbol, timeframe, date range, and execution assumptions; no win rate is guaranteed.
// =========================================================================================

// -----------------------------------------------------------------------------------------
// 1. INPUT PARAMETERS & STRATEGY PRESETS
// -----------------------------------------------------------------------------------------
grp_mode     = "★ STRATEGY ACCURACY MODE ★"
trade_dir    = input.string("Both (Long & Short)", "Trade Direction Filter", options=["Long Only (Bull Market Winner)", "Both (Long & Short)", "Short Only"], group=grp_mode)
use_ema200   = input.bool(true, "200 EMA Macro Trend Filter (Buy > 200, Sell < 200)", group=grp_mode)
use_dip_only = input.bool(true, "Value Dip Only (Buy pullback at 21 EMA / Golden Zone)", group=grp_mode)

grp_targets  = "1. Targets & Stop Loss (ATR Multipliers)"
atr_period   = input.int(14, "ATR Period", minval=1, group=grp_targets)
tp_mult      = input.float(1.00, "Target (x ATR)", minval=0.4, maxval=5.0, step=0.05, group=grp_targets)
sl_mult      = input.float(1.25, "Stop Loss Multiplier (x ATR)", minval=0.5, maxval=4.0, step=0.1, group=grp_targets)
be_trigger_pct = input.float(60.0, "Move SL to Entry after Target Progress (%)", minval=10.0, maxval=100.0, step=5.0, group=grp_targets)
use_be       = input.bool(true, "Move SL to Entry at Target Progress", group=grp_targets)

grp_risk     = "2. Risk-Based Position Sizing"
risk_per_trade_pct = input.float(0.5, "Equity Risk per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
max_exposure_pct = input.float(100.0, "Maximum Position Value (% Equity)", minval=1.0, maxval=500.0, step=1.0, group=grp_risk)
point_value_per_unit = input.float(1.0, "Price-Point Value per Unit", minval=0.000001, step=0.1, group=grp_risk, tooltip="Use 1 for most cash equities. For futures/options, set the contract multiplier.")
quantity_step = input.float(1.0, "Order Quantity Step", minval=0.000001, step=0.1, group=grp_risk, tooltip="Use 1 for whole-share instruments; set the broker's supported fractional/contract increment otherwise.")

grp_bt       = "0. Backtest Date Range Filter"
use_date     = input.bool(false, "Filter by Date Range", group=grp_bt)
start_date   = input.time(timestamp("2024-01-01 00:00"), "Start Date", group=grp_bt)
end_date     = input.time(timestamp("2026-12-31 23:59"), "End Date", group=grp_bt)
in_date_range = not use_date or (time >= start_date and time <= end_date)
holding_mode = input.string("Auto by timeframe", "Holding Mode", options=["Auto by timeframe", "Intraday square-off", "Positional"], group=grp_bt)
entry_session = input.session("0930-1445", "Entry Session (IST)", group=grp_bt)
intraday_mode = timeframe.isintraday and (holding_mode == "Intraday square-off" or (holding_mode == "Auto by timeframe" and timeframe.multiplier <= 15))
in_entry_session = not intraday_mode or not na(time(timeframe.period, entry_session, "Asia/Kolkata"))
square_off_bar = intraday_mode and not na(time_close) and hour(time_close, "Asia/Kolkata") >= 15

grp_fib      = "2. Fibonacci Golden Zone (0.50 - 0.618)"
show_gz      = input.bool(true, "Highlight Golden Zone", group=grp_fib)
gz_lookback  = input.int(24, "Swing Lookback Length", minval=5, maxval=100, group=grp_fib)

grp_st       = "3. Supertrend & EMA Configuration"
st_len       = input.int(10, "Supertrend ATR Period", minval=1, group=grp_st)
st_mult      = input.float(3.0, "Supertrend Multiplier", minval=0.1, step=0.1, group=grp_st)
show_ema     = input.bool(true, "Display EMA 9, 21, 50, 200", group=grp_st)
show_bb      = input.bool(true, "Display Bollinger Bands (20, 2)", group=grp_st)
show_vwap    = input.bool(true, "Display Session VWAP", group=grp_st)

grp_filters  = "4. Signal Confluence Filters"
use_st_filter = input.bool(true, "Require Supertrend Direction", group=grp_filters)
use_adx_filter = input.bool(true, "Require ADX Trend Strength", group=grp_filters)
min_adx      = input.float(22.0, "Minimum ADX", minval=1.0, step=0.5, group=grp_filters)
use_htf_filter = input.bool(true, "Require Confirmed Higher-Timeframe Trend", group=grp_filters)
use_auto_htf = input.bool(true, "Auto Higher Timeframe (10/15m→1h, 1h→1D, 1D→1W)", group=grp_filters)
manual_htf_res = input.timeframe("60", "Manual Higher Timeframe", group=grp_filters)
htf_res = use_auto_htf ? (timeframe.isintraday and timeframe.multiplier < 60 ? "60" : timeframe.isintraday ? "D" : "W") : manual_htf_res
require_momentum_break = input.bool(false, "Require Close Beyond Previous Bar", group=grp_filters)
pullback_confirm_bars = input.int(3, "Bars Allowed After Pullback", minval=0, maxval=10, group=grp_filters)
use_volume_filter = input.bool(false, "Require Above-Average Volume", group=grp_filters)
use_vwap_filter = input.bool(false, "Require Session VWAP Alignment", group=grp_filters)

grp_dash     = "5. On-Chart HUD Settings"
show_dash    = input.bool(true, "Show Live Intelligence HUD Table", group=grp_dash)
dash_pos     = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_dash)

// -----------------------------------------------------------------------------------------
// 2. MATHEMATICAL CORE & INDICATORS
// -----------------------------------------------------------------------------------------
atr_val = ta.atr(atr_period)

// Moving Averages
e9   = ta.ema(close, 9)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)

// Supertrend
[st_value, st_direction] = ta.supertrend(st_mult, st_len)
st_bull = st_direction < 0
st_bear = st_direction > 0

// Session VWAP
session_vwap = ta.vwap(hlc3)
above_vwap   = close >= session_vwap

// Wilder's RSI (14)
rsi_val = ta.rsi(close, 14)

// Volume Analytics
v_sma  = ta.sma(volume, 20)
vol_ok = volume >= v_sma

// Directional movement and trend strength
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

// Use only the last completed higher-timeframe candle to avoid realtime HTF repainting.
htf_bull = request.security("", htf_res, close[1] > ta.ema(close, 50)[1] and ta.ema(close, 50)[1] > ta.ema(close, 50)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htf_bear = request.security("", htf_res, close[1] < ta.ema(close, 50)[1] and ta.ema(close, 50)[1] < ta.ema(close, 50)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htf_filter_applicable = timeframe.in_seconds(htf_res) >= timeframe.in_seconds()

// Bollinger Bands (20, 2)
bb_mid     = ta.sma(close, 20)
bb_dev     = ta.stdev(close, 20) * 2.0
bb_up      = bb_mid + bb_dev
bb_lo      = bb_mid - bb_dev
bb_width   = (bb_up - bb_lo) / math.max(bb_mid, 0.0001)
bb_squeeze = bb_width < (ta.sma(bb_width, 20) * 0.80)

// Candle Structure
candle_body  = close - open
candle_range = math.max(high - low, 0.0001)
candle_bias  = candle_body / candle_range
bull_bar     = candle_bias > -0.05 and close >= nz(close[1], close)
bear_bar     = candle_bias < 0.05 and close <= nz(close[1], close)

lower_wick   = math.min(open, close) - low
upper_wick   = high - math.max(open, close)
is_hammer    = (lower_wick >= candle_range * 0.35) and (close >= open)
is_star      = (upper_wick >= candle_range * 0.35) and (close <= open)

// -----------------------------------------------------------------------------------------
// 3. FIBONACCI GOLDEN ZONE & SMC LIQUIDITY SWEEP
// -----------------------------------------------------------------------------------------
swing_hi    = ta.highest(high[1], gz_lookback)
swing_lo    = ta.lowest(low[1], gz_lookback)
swing_range = math.max(swing_hi - swing_lo, 0.0001)

bull_gz_top    = swing_hi - (swing_range * 0.50)
bull_gz_bottom = swing_hi - (swing_range * 0.618)
bear_gz_bottom = swing_lo + (swing_range * 0.50)
bear_gz_top    = swing_lo + (swing_range * 0.618)

in_bull_gz = (low <= bull_gz_top) and (close >= bull_gz_bottom) and bull_bar
in_bear_gz = (high >= bear_gz_bottom) and (close <= bear_gz_top) and bear_bar

fib_50  = close >= e200 ? bull_gz_top : bear_gz_bottom
fib_618 = close >= e200 ? bull_gz_bottom : bear_gz_top

sw_hi_25   = ta.highest(high[1], 25)
sw_lo_25   = ta.lowest(low[1], 25)
bull_sweep = (low < sw_lo_25) and (close > sw_lo_25) and ((math.min(open, close) - low) >= (math.abs(close - open) * 0.6) or close > open)
bear_sweep = (high > sw_hi_25) and (close < sw_hi_25) and ((high - math.max(open, close)) >= (math.abs(close - open) * 0.6) or close < open)

// -----------------------------------------------------------------------------------------
// 4. QUANTITATIVE HIGH WIN-RATE ENTRY SIGNALS
// -----------------------------------------------------------------------------------------
// 200 EMA Macro Trend
macro_bull = use_ema200 ? (close >= e200) : true
macro_bear = use_ema200 ? (close <= e200) : true

// Trend Alignment
trend_aligned_long  = (e9 > e21) and (e21 > e50) and (e50 > e50[1])
trend_aligned_short = (e9 < e21) and (e21 < e50) and (e50 < e50[1])

// Optional confluence filters
long_confluence_ok = (not use_st_filter or st_bull) and (not use_adx_filter or (adx_val >= min_adx and di_plus > di_minus)) and (not use_htf_filter or not htf_filter_applicable or htf_bull) and (not use_volume_filter or vol_ok) and (not use_vwap_filter or (not na(session_vwap) and above_vwap))
short_confluence_ok = (not use_st_filter or st_bear) and (not use_adx_filter or (adx_val >= min_adx and di_minus > di_plus)) and (not use_htf_filter or not htf_filter_applicable or htf_bear) and (not use_volume_filter or vol_ok) and (not use_vwap_filter or (not na(session_vwap) and close < session_vwap))

// Value Pullback Dip to EMA 21 / Support (Never buy peaks)
pullback_to_support = (low <= e21 + (atr_val * 0.25)) and (close >= e21 - (atr_val * 0.40))
pullback_to_resist  = (high >= e21 - (atr_val * 0.25)) and (close <= e21 + (atr_val * 0.40))

dip_long_ok  = use_dip_only ? (pullback_to_support or in_bull_gz or bull_sweep) : true
dip_short_ok = use_dip_only ? (pullback_to_resist or in_bear_gz or bear_sweep) : true

long_pullback_age = ta.barssince(pullback_to_support or in_bull_gz or bull_sweep)
short_pullback_age = ta.barssince(pullback_to_resist or in_bear_gz or bear_sweep)
long_pullback_valid = not use_dip_only or (not na(long_pullback_age) and long_pullback_age <= pullback_confirm_bars)
short_pullback_valid = not use_dip_only or (not na(short_pullback_age) and short_pullback_age <= pullback_confirm_bars)

// Reversal Confirmation
close_position = (close - low) / candle_range
reversal_long_ok  = (close > open) and (close > e9) and (close_position >= 0.65) and (not require_momentum_break or close > high[1]) and (rsi_val >= 50 and rsi_val <= 68) and (rsi_val > rsi_val[1])
reversal_short_ok = (close < open) and (close < e9) and ((high - close) / candle_range >= 0.65) and (not require_momentum_break or close < low[1]) and (rsi_val >= 32 and rsi_val <= 50) and (rsi_val < rsi_val[1])

// Direction Control
allow_long  = (trade_dir == "Both (Long & Short)" or trade_dir == "Long Only (Bull Market Winner)")
allow_short = (trade_dir == "Both (Long & Short)" or trade_dir == "Short Only")

// Master Triggers
bool buy_signal_raw  = barstate.isconfirmed and allow_long and macro_bull and trend_aligned_long and long_confluence_ok and long_pullback_valid and reversal_long_ok
bool sell_signal_raw = barstate.isconfirmed and allow_short and macro_bear and trend_aligned_short and short_confluence_ok and short_pullback_valid and reversal_short_ok

var int last_signal_dir = 0
if strategy.position_size == 0 and not buy_signal_raw and not sell_signal_raw
    last_signal_dir := 0

bool is_new_buy  = buy_signal_raw and (last_signal_dir != 1)
bool is_new_sell = sell_signal_raw and (last_signal_dir != -1)

if is_new_buy
    last_signal_dir := 1
if is_new_sell
    last_signal_dir := -1

string quality = ((buy_signal_raw and (in_bull_gz or bull_sweep)) or (sell_signal_raw and (in_bear_gz or bear_sweep))) ? "A+ Sniper" : "A Prime"

// -----------------------------------------------------------------------------------------
// 5. STRATEGY EXECUTION ENGINE (HIGH WIN-RATE EXITS)
// -----------------------------------------------------------------------------------------
var float sig_entry = na
var float sig_tp    = na
var float sig_sl    = na

min_contract = quantity_step
risk_cash_symbol = strategy.convert_to_symbol(strategy.equity * risk_per_trade_pct / 100.0)
max_exposure_symbol = strategy.convert_to_symbol(strategy.equity * max_exposure_pct / 100.0)
stop_distance = atr_val * sl_mult
risk_qty = stop_distance > 0 ? risk_cash_symbol / (stop_distance * point_value_per_unit) : 0.0
exposure_qty = close > 0 ? max_exposure_symbol / (close * point_value_per_unit) : 0.0
order_qty = math.floor(math.min(risk_qty, exposure_qty) / min_contract) * min_contract

// Dynamic Breakeven Stop Engine
var float active_sl = na

if strategy.position_size > 0
    // Move the stop to entry after price covers 40% of the target distance.
    if use_be and not na(sig_entry) and not na(sig_tp) and (high >= sig_entry + ((sig_tp - sig_entry) * be_trigger_pct / 100.0))
        active_sl := math.max(nz(active_sl, sig_sl), sig_entry)
    else
        active_sl := nz(active_sl, sig_sl)
else if strategy.position_size < 0
    if use_be and not na(sig_entry) and not na(sig_tp) and (low <= sig_entry - ((sig_entry - sig_tp) * be_trigger_pct / 100.0))
        active_sl := math.min(nz(active_sl, sig_sl), sig_entry)
    else
        active_sl := nz(active_sl, sig_sl)
else
    active_sl := na

// Strategy Entries
if in_date_range and in_entry_session
    // 1. Long Entry
    if is_new_buy and strategy.position_size <= 0 and order_qty >= min_contract
        sig_entry := close
        sig_tp    := close + (atr_val * tp_mult)
        sig_sl    := close - (atr_val * sl_mult)
        active_sl := sig_sl
        strategy.cancel("SELL Exit")
        strategy.entry("BUY", strategy.long, qty=order_qty, comment="BUY (" + quality + ")")
        strategy.exit("BUY Exit", "BUY", stop=sig_sl, limit=sig_tp, comment_loss="SL/BE Hit", comment_profit="Target Hit")

    // 2. Short Entry
    if is_new_sell and strategy.position_size >= 0 and order_qty >= min_contract
        sig_entry := close
        sig_tp    := close - (atr_val * tp_mult)
        sig_sl    := close + (atr_val * sl_mult)
        active_sl := sig_sl
        strategy.cancel("BUY Exit")
        strategy.entry("SELL", strategy.short, qty=order_qty, comment="SELL (" + quality + ")")
        strategy.exit("SELL Exit", "SELL", stop=sig_sl, limit=sig_tp, comment_loss="SL/BE Hit", comment_profit="Target Hit")

// Keep protective orders active even after the entry date range ends.
// On a reversal bar, the opposite entry replaces the position's bracket on the next calculation.
if strategy.position_size > 0 and not is_new_sell
    strategy.exit("BUY Exit", "BUY", stop=active_sl, limit=sig_tp, comment_loss="SL/BE Hit", comment_profit="Target Hit")

if strategy.position_size < 0 and not is_new_buy
    strategy.exit("SELL Exit", "SELL", stop=active_sl, limit=sig_tp, comment_loss="SL/BE Hit", comment_profit="Target Hit")

if square_off_bar
    strategy.close_all(comment="Intraday Square-off")

// -----------------------------------------------------------------------------------------
// 6. CHART VISUALIZATION & PLOTS
// -----------------------------------------------------------------------------------------
plot(st_value, title="Supertrend Band", color=st_bull ? color.new(#10b981, 0) : color.new(#f43f5e, 0), linewidth=2)
plot(show_ema ? e9 : na, title="EMA 9 (Fast Momentum)", color=color.new(#38bdf8, 30), linewidth=1)
plot(show_ema ? e21 : na, title="EMA 21 (Pullback Core)", color=color.new(#f59e0b, 10), linewidth=2)
plot(show_ema ? e50 : na, title="EMA 50 (Trend Anchor)", color=color.new(#a855f7, 30), linewidth=2)
plot(show_ema ? e200 : na, title="EMA 200 (Institutional Trend)", color=color.new(#ef4444, 20), linewidth=2)

// Bollinger Bands
p_bb_up = plot(show_bb ? bb_up : na, "Bollinger Upper", color=color.new(#38bdf8, 50), linewidth=1)
p_bb_lo = plot(show_bb ? bb_lo : na, "Bollinger Lower", color=color.new(#38bdf8, 50), linewidth=1)
fill(p_bb_up, p_bb_lo, color=color.new(#38bdf8, 95), title="Bollinger Channel Area")

plot(show_vwap ? session_vwap : na, title="Session VWAP", color=color.new(#ec4899, 10), linewidth=2)
plot(active_sl, title="Active Protected Stop Loss", color=color.new(#f43f5e, 20), linewidth=2, style=plot.style_linebr)

// Fibonacci Golden Zone Band (0.50 - 0.618)
p_fib618 = plot(show_gz ? fib_618 : na, "Golden Zone 0.618", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
p_fib50  = plot(show_gz ? fib_50 : na, "Golden Zone 0.50", color=color.new(#f59e0b, 40), linewidth=1, style=plot.style_linebr)
fill(p_fib618, p_fib50, color=color.new(#f59e0b, 88), title="Golden Zone Area Fill")

// SMC Liquidity Sweep Badges
plotshape(bull_sweep, title="SMC Bullish Liquidity Sweep", style=shape.diamond, location=location.belowbar, color=#38bdf8, textcolor=color.white, size=size.small, text="◆ SMC SWEEP")
plotshape(bear_sweep, title="SMC Bearish Liquidity Sweep", style=shape.diamond, location=location.abovebar, color=#e11d48, textcolor=color.white, size=size.small, text="◆ SMC SWEEP")

// Candlestick Tinting
barcolor(st_bull and macro_bull ? color.new(#10b981, 0) : st_bear and macro_bear ? color.new(#f43f5e, 0) : na, title="Confluence Bar Tint")
bgcolor(is_new_buy ? color.new(#10b981, 85) : is_new_sell ? color.new(#f43f5e, 85) : na, title="Signal Bar Background")

// Plot Signal Badges
plotshape(is_new_buy, title="BUY Alert", style=shape.labelup, location=location.belowbar, color=#10b981, textcolor=color.white, size=size.normal, text="⚡ BUY")
plotshape(is_new_sell, title="SELL Alert", style=shape.labeldown, location=location.abovebar, color=#f43f5e, textcolor=color.white, size=size.normal, text="⚡ SELL")

// -----------------------------------------------------------------------------------------
// 7. ON-CHART INSTITUTIONAL HUD DASHBOARD TABLE
// -----------------------------------------------------------------------------------------
var table_pos = position.top_right
if dash_pos == "Bottom Right"
    table_pos := position.bottom_right
else if dash_pos == "Top Left"
    table_pos := position.top_left
else if dash_pos == "Bottom Left"
    table_pos := position.bottom_left

var table hud = table.new(table_pos, 2, 9, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_dash
    string sig_status = is_new_buy or (last_signal_dir == 1 and not is_new_sell) ? "STRONG BUY" : is_new_sell or (last_signal_dir == -1 and not is_new_buy) ? "STRONG SELL" : "WAITING / SCANNING"
    color sig_color   = sig_status == "STRONG BUY" ? color.new(#10b981, 0) : sig_status == "STRONG SELL" ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0)

    table.cell(hud, 0, 0, "FinGroww Strategy Pro", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "Trend Pullback v6", bgcolor=color.new(#1e293b, 10), text_color=color.new(#38bdf8, 0), text_size=size.small)

    table.cell(hud, 0, 1, "Market Signal", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 1, sig_status + " (" + quality + ")", text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 2, "200 EMA Macro Shield", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 2, close >= e200 ? "BULLISH > 200 EMA ▲" : "BEARISH < 200 EMA ▼", text_color=close >= e200 ? color.green : color.red, text_size=size.small)

    table.cell(hud, 0, 3, "Golden Zone (0.5-0.618)", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 3, in_bull_gz ? "Bull Golden Tap 🎯" : in_bear_gz ? "Bear Golden Tap 🎯" : "Normal Zone", text_color=(in_bull_gz or in_bear_gz) ? color.new(#f59e0b, 0) : color.gray, text_size=size.small)

    table.cell(hud, 0, 4, "RSI (14) Momentum", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(rsi_val, "#.#") + (rsi_val >= 50 ? " (Bullish Momentum)" : " (Bearish Flow)"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "Backtest Win Rate", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    float cur_wr = math.round(strategy.wintrades / math.max(1, strategy.closedtrades) * 100, 1)
    table.cell(hud, 1, 5, str.tostring(cur_wr) + "% (" + str.tostring(strategy.closedtrades) + " Closed Trades)", text_color=cur_wr >= 70 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    float profit_factor = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    table.cell(hud, 0, 6, "Profit Factor", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 6, na(profit_factor) ? "n/a" : str.tostring(profit_factor, "#.###"), text_color=profit_factor >= 1.0 ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)

    table.cell(hud, 0, 7, "Target / Protected SL", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 7, na(sig_tp) ? "—" : "TP: " + str.tostring(sig_tp, "#.#") + " | SL: " + str.tostring(active_sl, "#.#"), text_color=color.new(#facc15, 0), text_size=size.small)

    table.cell(hud, 0, 8, "SMC & Dip Rejection", text_color=color.new(#cbd5e1, 0), text_size=size.small)
    table.cell(hud, 1, 8, bull_sweep ? "Bull Sweep 💧" : bear_sweep ? "Bear Sweep 💧" : is_hammer ? "Hammer Rejection 🔨" : is_star ? "Shooting Star ⭐" : "Scanning Dips", text_color=bull_sweep or is_hammer ? color.new(#10b981, 0) : bear_sweep or is_star ? color.new(#f43f5e, 0) : color.new(#94a3b8, 0), text_size=size.small)
